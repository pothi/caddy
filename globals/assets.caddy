# 1. Capture the base path and extension (same as before)
# @is_image path_regexp img ^(?P<base>.+)\.(?P<ext>png|jpg|jpeg)$

# route @is_image {
    # 2. Check for AVIF support and file existence
    # @try_avif {
        # header Accept *image/avif*
        # file {re.img.base}-{re.img.ext}.avif
    # }
    # If AVIF works, rewrite and stop here for this request
    # rewrite @try_avif {re.img.base}-{re.img.ext}.avif

    # Check for WebP support and file existence
    # @try_webp {
        # header Accept *image/webp*
        # file {re.img.base}-{re.img.ext}.webp
    # }
    # If WebP works (and AVIF didn't), rewrite here
    # rewrite @try_webp {re.img.base}-{re.img.ext}.webp
